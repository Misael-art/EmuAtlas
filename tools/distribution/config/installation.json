    "retrofe": {
      "kind": "build",
      "requires": [
        "host-packages"
      ],
      "repository": "https://github.com/phulshof/RetroFE.git",
      "commit": "9f9230d09cbd4dae074b9465ca090567fd0623e7",
      "sparse_paths": [
        "RetroFE/Source",
        "RetroFE/CMake",
        "RetroFE/ThirdParty/sqlite3",
        "RetroFE/ThirdParty/rapidxml-1.13"
      ],
      "commands": [
        [
          "cmake",
          "-S",
          "{source}/RetroFE/Source",
          "-B",
          "{build}",
          "-G",
          "Ninja",
          "-DCMAKE_BUILD_TYPE=Release",
          "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
          "-DVERSION_MAJOR=0",
          "-DVERSION_MINOR=10",
          "-DVERSION_BUILD=0"
        ],
        [
          "cmake",
          "--build",
          "{build}",
          "--parallel",
          "{jobs}"
        ]
      ],
      "output": "{source}/RetroFE/Build/retrofe",
      "target": "frontend/RetroFE/RetroFE",
      "source_page": "https://github.com/phulshof/RetroFE"
    },
    "zarchive": {
      "kind": "build",
      "requires": [
        "host-packages"
      ],
      "source": {
        "url": "https://codeload.github.com/Exzap/ZArchive/tar.gz/d2c717730092c7bf8cbb033b12fd4001b7c4d932",
        "size_bytes": 19782,
        "sha256": "96a1be457dd289c24e33a76a1020d0a974d992f771dd3cb7a6dac9c8427e6f8e",
        "allowed_hosts": [
          "codeload.github.com"
        ]
