      "commands": [
        [
          "cmake",
          "-S",
          "{source}",
          "-B",
          "{build}",
          "-G",
          "Ninja",
          "-DCMAKE_BUILD_TYPE=Release"
        ],
        [
          "cmake",
          "--build",
          "{build}",
          "--parallel",
          "{jobs}"
        ]
      ],
      "output": "{build}/zarchive",
      "target": "tools/roms/runtimes/zarchive/bin/zarchive",
      "source_page": "https://github.com/Exzap/ZArchive/tree/v0.1.2",
      "patches": [
        {
          "file": "src/zarchivewriter.cpp",
          "before": "_ZARCHIVE::COMPRESSED_BLOCK_SIZE, 6);",
          "after": "_ZARCHIVE::COMPRESSED_BLOCK_SIZE, ZSTD_maxCLevel());",
          "reason": "Preserve existing maximum lossless compression policy; chunk size unchanged."
        }
      ]
    },
