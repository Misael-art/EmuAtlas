{
  "schema_version": "1.0",
  "purpose": "Lossless conversion to a format that the configured emulator can open directly. Profiles are an allowlist; unknown systems and formats remain unchanged.",
  "preserve_name_markers": [
    {
      "id": "modified-or-translated-content",
      "parser": "legacy-variant-name-v1",
      "regex": "",
      "reason": "Parser considera marcadores explícitos em grupos do nome e preserva candidatos para revisão; palavras comuns no título não devem gerar falso positivo."
    }
  ],
  "profiles": [
    {
      "id": "dolphin-rvz",
      "systems": [
        "gc",
        "wii"
      ],
      "source_extensions": [
        ".iso"
      ],
      "target_extension": ".rvz",
      "runtime_adapter": "flatpak",
      "runtime_app_id": "org.DolphinEmu.dolphin-emu",
      "runtime_format": "RVZ",
      "runtime_evidence": [
        "https://github.com/dolphin-emu/dolphin/blob/master/Readme.md",
        "https://github.com/dolphin-emu/dolphin/blob/master/Source/Core/DiscIO/WIABlob.cpp (GetAllowedCompressionLevels returns ZSTD_maxCLevel for the CLI)",
        "host-linux.json lists RVZ for GC/Wii"
      ],
      "compression": {
        "codec": "zstd",
        "level": 22,
        "block_size_bytes": 131072
      },
      "tool_executable": "flatpak",
      "minimum_free_source_multiplier": 1,
      "tool_probe": [
        "flatpak",
        "info",
        "org.DolphinEmu.dolphin-emu"
      ],
      "convert": [
        "flatpak",
        "run",
        "--command=dolphin-tool",
        "org.DolphinEmu.dolphin-emu",
        "convert",
        "--input",
        "{source}",
        "--output",
        "{destination}",
        "--format",
        "rvz",
        "--compression",
        "zstd",
        "--compression_level",
        "22",
        "--block_size",
        "131072"
      ],
      "source_validate": [
        "flatpak",
        "run",
        "--command=dolphin-tool",
        "org.DolphinEmu.dolphin-emu",
        "verify",
        "--input",
        "{path}"
      ],
      "validate": [
        "flatpak",
        "run",
        "--command=dolphin-tool",
        "org.DolphinEmu.dolphin-emu",
        "verify",
        "--input",
        "{path}"
      ],
      "digest": [
        "flatpak",
        "run",
        "--command=dolphin-tool",
        "org.DolphinEmu.dolphin-emu",
        "verify",
        "--input",
        "{path}",
        "--algorithm",
        "sha1"
      ],
      "header": [
        "flatpak",
        "run",
        "--command=dolphin-tool",
        "org.DolphinEmu.dolphin-emu",
        "header",
        "--input",
        "{path}",
        "--json"
      ],
      "header_identity_fields": [
        "game_id",
        "country",
        "region",
        "revision",
        "internal_name"
      ],
      "rollback_convert": [
        "flatpak",
        "run",
        "--command=dolphin-tool",
        "org.DolphinEmu.dolphin-emu",
        "convert",
        "--input",
        "{source}",
        "--output",
        "{destination}",
        "--format",
        "iso"
      ],
      "rollback_validate": [
        "flatpak",
        "run",
        "--command=dolphin-tool",
        "org.DolphinEmu.dolphin-emu",
        "verify",
        "--input",
        "{path}"
      ],
      "rollback_digest": [
        "flatpak",
        "run",
        "--command=dolphin-tool",
        "org.DolphinEmu.dolphin-emu",
        "verify",
        "--input",
        "{path}",
        "--algorithm",
        "sha1"
      ],
      "rollback_digest_kind": "command",
      "roundtrip_validation": "Dolphin verifies both disc images and reports the same logical disc SHA-1. No scrub option is used."
    },
    {
      "id": "pcsx2-chd-dvd",
