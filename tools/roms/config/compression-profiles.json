      "tool_executable": "chdman",
      "source_validate": [],
      "convert": [
        "chdman",
        "createdvd",
        "-i",
        "{source}",
        "-o",
        "{destination}"
      ],
      "validate": [
        "chdman",
        "verify",
        "-i",
        "{path}"
      ],
      "digest_kind": "sha256_extracted_raw",
      "digest_extract": [
        "chdman",
        "extractraw",
        "-i",
        "{path}",
        "-o",
        "{digest_output}"
      ],
      "rollback_convert": [
        "chdman",
        "extractraw",
        "-i",
        "{source}",
        "-o",
        "{destination}"
      ],
      "rollback_validate": [],
      "rollback_digest_kind": "sha256_file",
      "roundtrip_validation": "Extract the verified CHD to a temporary raw image and compare its SHA-256 with the source ISO."
    },
