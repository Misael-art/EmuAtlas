        "extractraw",
        "-i",
        "{path}",
        "-o",
        "{digest_output}"
      ],
      "rollback_convert": [
        "chdman",
        "extractraw",
        "-i",
        "{source}",
        "-o",
        "{destination}"
      ],
      "rollback_validate": [],
