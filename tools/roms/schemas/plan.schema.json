{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roms-change-plan-v1",
  "title": "ROM maintenance change plan",
  "type": "object",
  "required": ["title", "actions"],
  "properties": {
    "operation_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "source", "destination", "system_id", "item_identity",
                     "classification", "reason", "reference_check", "validation_result",
                     "dependency_check"],
        "properties": {
          "action": {"enum": ["move", "rename", "quarantine", "extract", "steam_move_link", "steam_save_move_link"]},
          "source": {"type": "string"},
          "destination": {"type": "string"},
          "system_id": {"type": "string"},
          "item_identity": {"type": "string"},
          "classification": {"enum": ["game", "update", "dlc", "mod", "media", "support",
                                       "corrupt_candidate", "duplicate", "container", "set"]},
          "reason": {"type": "string"},
          "reference_check": {"enum": ["checked_none", "not_applicable", "referenced", "pending"]},
          "validation_result": {"type": "string"},
          "dependency_check": {"type": "string"},
          "frontend_references": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
